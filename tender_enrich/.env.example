# JSONL tender input path.
INPUT_PATH=./data/tenders.jsonl
# Enriched JSONL output path; input is never overwritten.
OUTPUT_PATH=./data/tenders_enriched.jsonl
# Global seed; stable per-tender streams are derived from this value.
SEED=42
# Logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
# Log format: text or json.
LOG_FORMAT=text
# Minimum randomly assigned synthetic estimated value in INR for every tender.
DEFAULT_VALUE_MIN=500000
# Maximum randomly assigned estimated value in INR; must not exceed ₹5 crore.
DEFAULT_VALUE_MAX=50000000
