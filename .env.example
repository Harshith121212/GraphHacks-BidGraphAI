# =================================================================
# BidGraphAI Environment Configuration
# =================================================================

# --- FalkorDB Database Configuration ---
# For Render deployment with FalkorDB Cloud (https://app.falkordb.cloud):
# Set FALKORDB_HOST=your-instance.falkordb.cloud, FALKORDB_PASSWORD, and FALKORDB_SSL=true
# For local development with Docker, keep FALKORDB_HOST=localhost (or falkordb in compose)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_GRAPH_NAME=tender_intel_graph

# Automatically seed benchmark tenders & contractors on first startup (true/false)
AUTO_SEED=true

# --- AI Reasoning Engine (NVIDIA Nemotron 3.5) ---
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_API_KEY_ALPHA=your_openrouter_api_key_1
OPENROUTER_API_KEY_BETA=your_openrouter_api_key_2
OPENROUTER_API_KEY=

# Optional: Hugging Face Token for Nemotron 3.5 inference fallback
HF_TOKEN=

# Optional: Gemini API Key for Communication Agent email drafting
GEMINI_API_KEY=

# --- Autonomous Tender Alert Email Dispatch ---
DEFAULT_ALERT_EMAIL=hackathon-demo@outlook.com

# Optional SMTP Settings (leave blank for simulated safe outbox dispatch)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BidGraphAI Alerts <hackathon-demo@outlook.com>

# Optional Transactional Email API Keys
RESEND_API_KEY=
BREVO_API_KEY=
SENDGRID_API_KEY=
