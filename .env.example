# FalkorDB Database Configuration (Docker local or FalkorDB Cloud)
FALKORDB_INSTANCE_ID=your_instance_id_here
FALKORDB_HOST=your_cloud_host_endpoint_here
FALKORDB_PORT=6379
FALKORDB_USERNAME=your_username_here
FALKORDB_PASSWORD=your_password_here
FALKORDB_SSL=false
FALKORDB_URL=
FALKORDB_GRAPH_NAME=tender_intel_graph

# Dual-Agent OpenRouter Configuration (NVIDIA Nemotron 3.5 Super VL - Free Model)
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_API_KEY_ALPHA=your_openrouter_api_key_1
OPENROUTER_API_KEY_BETA=your_openrouter_api_key_2
